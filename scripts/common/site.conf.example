# Site-local overrides for scripts/common/env.sh.
#
#     cp site.conf.example site.conf     # site.conf is gitignored
#
# Everything here is optional — env.sh has working defaults.  Environment
# variables set at launch time still win over this file for NTASKS/CPT etc.
# (env.sh only fills in unset values), EXCEPT plain assignments below, which
# would override the environment — keep the ${VAR:-...} form when in doubt.

# conda install location / env name
#CONDA_ROOT=$HOME/miniconda3
#CONDA_ENV=qaqmc

# Bare-server resource defaults (ignored inside a SLURM job)
#CPT=${CPT:-4}
#NTASKS=${NTASKS:-8}

# Core binding (Open MPI / hwloc syntax — vendor-neutral).
# AMD EPYC (many small NUMA domains): map by NUMA node instead of slot:
#BIND_FLAGS="--map-by numa:PE=${CPT:-1} --bind-to core"
# cgroup-limited container / shared box where binding fights the cgroup mask:
#BIND_FLAGS="--bind-to none"

# Extra mpiexec flags, e.g. allow more ranks than cores on a laptop:
#MPI_EXTRA_FLAGS="--oversubscribe"
